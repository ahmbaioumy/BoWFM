{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:standalone": "npx tsx scripts/build-standalone.mts",
    "check:artifact": "npx tsx scripts/check-artifact-freshness.mts",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','dist-standalone','server.js']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "npx tsx scripts/verify-fixes.mts && npx tsx scripts/verify-sizing-fixes.mts && npx tsx scripts/check-artifact-freshness.mts",
    "test:sizing": "npx tsx scripts/verify-sizing-fixes.mts",
    "test:trusted-source": "npx tsx scripts/verify-trusted-source.mts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
